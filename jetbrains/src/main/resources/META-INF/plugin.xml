<idea-plugin>
    <id>com.deplens.go.depLens</id>
    <name>Dep Lens for Go</name>
    <vendor>DepLens</vendor>
    <description>在Go的import语句后显示GitHub的star数和最后更新时间</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.go</depends>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.inlayProvider
                implementationClass="com.deplens.go.GithubImportInlayProvider"
                language="go"/>
    </extensions>
</idea-plugin>