<idea-plugin>
    <id>deplens</id>
    <name>Dep Lens</name>
    <version>0.2.0</version>
    <vendor email="gaoxiao6331@163.com">gaoxiao</vendor>
    <description>View details of third-party dependencies</description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="go.xml">org.jetbrains.plugins.go</depends>
    <depends optional="true" config-file="ts.xml">JavaScript</depends>
    <depends optional="true" config-file="java/java.xml">com.intellij.modules.java</depends>
    <depends config-file="java/kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="java/maven.xml">org.jetbrains.idea.maven</depends>
    <depends optional="true" config-file="java/gradle.xml">org.jetbrains.plugins.gradle</depends>

    <resource-bundle>messages.DepLensBundle</resource-bundle>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
