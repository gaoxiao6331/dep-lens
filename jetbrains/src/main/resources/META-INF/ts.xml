<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.declarativeInlayProvider
                implementationClass="deplens.lang.ts.TsDepLensInlayProvider"
                language="JavaScript"
                isEnabledByDefault="true"
                group="OTHER_GROUP"
                providerId="deplens.inlay.js"
                nameKey="pluginName"
                bundle="messages.DepLensBundle"/>
        <codeInsight.declarativeInlayProvider
                implementationClass="deplens.lang.ts.PackageJsonDepLensInlayProvider"
                language="JSON"
                isEnabledByDefault="true"
                group="OTHER_GROUP"
                providerId="deplens.inlay.packagejson"
                nameKey="pluginName"
                bundle="messages.DepLensBundle"/>
    </extensions>
</idea-plugin>
