{
  "name": "dep-lens",
  "displayName": "Dep Lens",
  "description": "Dep Lens shows dependency health signals directly in your editor so you can quickly evaluate third-party packages while coding.",
  "version": "0.1.2",
  "icon": "docs/img/logo_rect.png",
  "publisher": "gaoxiao",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gaoxiao6331/dep-lens.git"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:kotlin",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:groovy",
    "onLanguage:json",
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Dep Lens",
      "properties": {
        "depLens.githubToken": {
          "type": "string",
          "default": "",
          "description": "GitHub Token (Leave empty to use anonymous or GITHUB_TOKEN env var)"
        },
        "depLens.logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "description": "Log level for Dep Lens"
        }
      }
    },
    "commands": [
      {
        "command": "depLens.clearCache",
        "title": "Dep Lens: clearCache"
      },
      {
        "command": "depLens.retry",
        "title": "Dep Lens: Retry loading dependency info"
      }
    ],
    "languages": [
      {
        "id": "go",
        "aliases": ["Go", "golang"]
      },
      {
        "id": "java",
        "aliases": ["Java"]
      },
      {
        "id": "kotlin",
        "aliases": ["Kotlin"]
      },
      {
        "id": "javascript",
        "aliases": ["JavaScript"]
      },
      {
        "id": "typescript",
        "aliases": ["TypeScript"]
      },
      {
        "id": "groovy",
        "aliases": ["Groovy"]
      },
      {
        "id": "json",
        "aliases": ["JSON"]
      },
      {
        "id": "xml",
        "aliases": ["XML"]
      }
    ]
  },
  "scripts": {
    "build": "pnpm build:wasm && tsup src/extension.ts --format cjs --dts --out-dir dist --external vscode",
    "build:wasm": "cargo build --manifest-path ../lib/Cargo.toml --target wasm32-unknown-unknown --release && mkdir -p lib && cp ../lib/target/wasm32-unknown-unknown/release/dep_lens_lib.wasm lib/dep_lens_lib.wasm",
    "watch": "tsup src/extension.ts --format cjs --dts --out-dir dist --watch --external vscode",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build && cp -r ../README.md ../LICENSE ../docs ../config .",
    "package": "vsce package",
    "publish": "vsce publish",
    "check": "biome check --fix ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.3",
    "@types/node": "^20.11.17",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^3.7.1",
    "cheerio": "1.0.0-rc.12",
    "tsup": "^8.0.1",
    "typescript": "^5.4.5",
    "undici": "^5.29.0"
  },
  "dependencies": {},
  "files": ["dist", "lib", "config", "docs", "README.md", "LICENSE"]
}
