{
  "name": "dep-lens",
  "displayName": "Dep Lens",
  "description": "View details of third-party dependencies",
  "version": "0.1.0",
  "publisher": "gaoxiao",
  "private": true,
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:go"],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Dep Lens",
      "properties": {
        "depLens.githubToken": {
          "type": "string",
          "default": "",
          "description": "GitHub Token (Leave empty to use anonymous or GITHUB_TOKEN env var)"
        }
      }
    },
    "commands": [
      {
        "command": "depLens.clearCache",
        "title": "Dep Lens: clearCache"
      }
    ],
    "languages": [
      {
        "id": "go",
        "aliases": ["Go", "golang"]
      }
    ]
  },
  "scripts": {
    "build": "tsup src/extension.ts --format cjs --dts --out-dir dist --external vscode",
    "watch": "tsup src/extension.ts --format cjs --dts --out-dir dist --watch --external vscode",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup src/extension.ts --format cjs --dts --out-dir dist --external vscode",
    "package": "vsce package",
    "publish": "vsce publish",
    "check": "biome check --fix ."
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/vscode": "^1.86.0",
    "tsup": "^8.0.1",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^3.0.0",
    "@biomejs/biome": "^1.7.3"
  },
  "dependencies": {
    "undici": "^6.18.2"
  },
  "files": ["dist"]
}
